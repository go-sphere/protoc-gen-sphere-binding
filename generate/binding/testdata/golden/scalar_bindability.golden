# Shared scalar-bindability contract for protoc-gen-sphere and
# protoc-gen-sphere-binding, over proto/scalar_bindability.proto.
#
# KEEP BYTE-IDENTICAL in both repositories and update both together:
#   protoc-gen-sphere:         generate/http/testdata/golden/scalar_bindability.golden
#   protoc-gen-sphere-binding: generate/binding/testdata/golden/scalar_bindability.golden
# Each repository has a TestScalarBindabilityContract that runs its own
# implementation over the fixture and must reproduce these rows exactly, in
# order. Edit this table by hand as the contract; do not regenerate it from one
# plugin's output.
#
# Columns: location  field  kind  decision
#   kind     - fieldKindDesc, as printed in the generation-time error
#   decision - accept: the field is bound in that location
#              reject: generation fails, the field has no single-token form
# QUERY/URI/HEADER accept scalars and enums only: every message field is
# rejected, well-known types (Timestamp, Duration, wrapperspb.*Value) included,
# because the httpx form decoders cannot read them from a single token. FORM
# accepts every field.

query  f_double           double   accept
query  f_float            float    accept
query  f_int32            int32    accept
query  f_int64            int64    accept
query  f_uint32           uint32   accept
query  f_uint64           uint64   accept
query  f_sint32           sint32   accept
query  f_sint64           sint64   accept
query  f_fixed32          fixed32  accept
query  f_fixed64          fixed64  accept
query  f_sfixed32         sfixed32 accept
query  f_sfixed64         sfixed64 accept
query  f_bool             bool     accept
query  f_string           string   accept
query  f_bytes            bytes    reject
query  f_enum             enum     accept
query  f_message          message  reject
query  wkt_timestamp      message  reject
query  wkt_duration       message  reject
query  wkt_string_value   message  reject
query  wkt_bytes_value    message  reject
query  wkt_bool_value     message  reject
query  wkt_double_value   message  reject
query  wkt_float_value    message  reject
query  wkt_int32_value    message  reject
query  wkt_uint32_value   message  reject
query  wkt_int64_value    message  reject
query  wkt_uint64_value   message  reject
query  wkt_struct         message  reject
query  wkt_value          message  reject
query  wkt_list_value     message  reject
query  wkt_any            message  reject
query  wkt_field_mask     message  reject
query  wkt_empty          message  reject
query  rep_int32          int32    accept
query  rep_string         string   accept
query  rep_bytes          bytes    reject
query  rep_enum           enum     accept
query  rep_message        message  reject
query  rep_timestamp      message  reject
query  rep_struct         message  reject
query  map_string_string  map      reject
query  map_int64_bytes    map      reject
query  map_string_message map      reject
query  opt_int32          int32    accept
query  opt_string         string   accept
query  opt_bytes          bytes    reject
query  opt_enum           enum     accept
query  opt_message        message  reject
query  opt_timestamp      message  reject
query  one_string         string   accept
query  one_bytes          bytes    reject
query  one_enum           enum     accept
query  one_message        message  reject
query  one_int64_value    message  reject

